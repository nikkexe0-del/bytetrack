<?xml version="1.0" encoding="utf-8"?>
<!--
  byte!track app icon concept: a dial/tracking ring (the "time" half of the app - screen time)
  wrapped around three ascending bars (the "data" half - usage climbing over the day), with a
  small marker dot at 12 o'clock standing in for a progress/"currently tracking" indicator.
  One glyph, two metrics - matches what the app actually does instead of a generic placeholder.

  Kept inside a ~64dp-diameter safe zone centered in the 108x108 canvas so it isn't clipped by
  circle/squircle/rounded-square adaptive icon masks on different launchers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tracking ring -->
    <path
        android:pathData="M 24,54 a30,30 0 1 0 60,0 a30,30 0 1 0 -60,0 z"
        android:strokeColor="#FF6A1A"
        android:strokeWidth="5"
        android:fillColor="#00000000" />

    <!-- 12 o'clock marker dot -->
    <path
        android:pathData="M 50.5,24 a3.5,3.5 0 1 0 7,0 a3.5,3.5 0 1 0 -7,0 z"
        android:fillColor="#FF6A1A" />

    <!-- Ascending data bars -->
    <path
        android:pathData="M 37.5,56 L 44.5,56 L 44.5,68 L 37.5,68 Z"
        android:fillColor="#FF6A1A" />
    <path
        android:pathData="M 50.5,48 L 57.5,48 L 57.5,68 L 50.5,68 Z"
        android:fillColor="#FF6A1A"
        android:fillAlpha="0.85" />
    <path
        android:pathData="M 63.5,40 L 70.5,40 L 70.5,68 L 63.5,68 Z"
        android:fillColor="#FF6A1A"
        android:fillAlpha="0.7" />
</vector>
