<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteViews can't do real backdrop blur (that needs graphicsLayer/RenderEffect, Compose-only),
  so the widget approximates byte!track's "liquid glass" look with a flat dark card + soft
  stroke instead - same corner radius and border treatment as GlassCard, just without the blur.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/carbon_black" />
    <stroke android:width="1dp" android:color="@color/widget_card_stroke" />
    <corners android:radius="18dp" />
</shape>
